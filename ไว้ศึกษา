local function SmoothGlide_Full(rootPart, targetPos, speed)
    if not rootPart then return end

    -- ทำความสะอาดฟิสิกส์ (ลบแรงกระทำทั้งหมด)
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero

    -- ปิดการชน (Noclip)
    for _, part in ipairs(rootPart.Parent:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end

    -- ปิดเสียงเท้าเพื่อความเนียน
    local hrp = rootPart
    local runningSound = hrp:FindFirstChild("Running") or hrp:FindFirstChild("Walk")
    if runningSound and runningSound:IsA("Sound") then
        runningSound.Volume = 0
    end

    local dist = (targetPos - rootPart.Position).Magnitude
    local timeToReach = dist / math.max(10, speed)

    local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
    local tween = game:GetService("TweenService"):Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
    tween:Play()
    return tween
end

