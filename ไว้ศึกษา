3. การดึงภาพ/ไอคอน จากเกมมาใส่ UI (UI Image Extraction)
==================================================
หากต้องการทำ ESP ไข่หรือไอเทม การเอา "id ภาพ" มาใส่ `ImageLabel` ใน UI ต้องใช้ฟอร์แมต `rbxassetid://` เสมอ
Chilli Hub ใช้วิธีเจาะลึกเข้าไปใน Model ของสิ่งของเพื่อหา Texture แท้ๆ

-- โค้ดดึงภาพสำหรับใช้กับ ImageLabel ใน BillboardGui (ESP)
local function GetIconForUI(itemModel)
    local iconId = nil
    
    -- 1. ลองหาจาก Attribute ยอดฮิตก่อน
    local attrNames = {"Icon", "IconId", "AssetId", "Image", "ImageId", "Thumbnail", "TextureId"}
    for _, attrName in ipairs(attrNames) do
        local attrValue = itemModel:GetAttribute(attrName)
        if attrValue and tostring(attrValue) ~= "" then
            iconId = attrValue
            break
        end
    end
    
    -- 2. ถ้าใน Attribute ไม่มี ให้มุดลงไปหาใน Part ต่างๆ ของ Model
    if not iconId then
        for _, obj in ipairs(itemModel:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then 
                iconId = obj.Texture 
                break 
            elseif (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and obj.Image ~= "" then 
                iconId = obj.Image 
                break 
            elseif obj:IsA("MeshPart") and obj.TextureID ~= "" then 
                iconId = obj.TextureID 
                break 
            end
        end
    end
    
    -- 3. แปลงค่าที่ได้ ให้อยู่ในฟอร์แมต rbxassetid:// เพื่อใช้ใน UI ImageLabel.Image
    if type(iconId) == "number" or (type(iconId) == "string" and iconId:match("^%d+$")) then
        return "rbxassetid://" .. tostring(iconId)
    end
    if type(iconId) == "string" then
        -- ถ้ามันมี http หรือ rbxassetid ปนมาด้วย ให้สกัดเอาแต่ตัวเลข แล้วประกอบใหม่
        local id = iconId:match("rbxassetid://(%d+)") or iconId:match("[?&]id=(%d+)")
        if id then 
            return "rbxassetid://" .. id 
        end
        return iconId -- ถ้าสกัดไม่ได้ ให้คืนค่าเดิมกลับไป
    end
    
    return "" -- ถ้าหาไม่ได้จริงๆ ให้ส่งค่าว่างกลับ
end


