4. ระบบตั้งค่าการชน (Collision & Physics Bypass) สำหรับการ Tween / บิน
==================================================
เวลาบินหรือเดินทะลุกำแพง ระบบมักจะโดนดึงกลับด้วยแรงดึงดูดหรือชนนู่นชนนี่ 
Chilli Hub ใช้การจัดการ AssemblyLinearVelocity

-- โค้ดทำความสะอาดแรงเหวี่ยงและระงับแรงชนตอนกำลัง Tween (Glide)
local function GlideSteer(rootPart, targetPos, speed)
    if not rootPart then return end
    
    -- ลบแรงโน้มถ่วงและแรงหมุน (ห้ามตก)
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    
    -- คำนวณระยะทาง
    local dist = (targetPos - rootPart.Position).Magnitude
    local timeToReach = dist / speed
    
    -- ปิดการชนของชิ้นส่วนตัวละคร
    for _, part in ipairs(rootPart.Parent:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
    
    -- สร้าง Tween
    local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
    local tween = game:GetService("TweenService"):Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
    tween:Play()
    
    return tween
end
