local function ProcessFusery_Full(fuseryData)
    local networking = game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Networking")
    local rfLoad = networking:FindFirstChild("RF/Fusery/LoadPet")
    local rfBegin = networking:FindFirstChild("RF/Fusery/BeginFuse")
    local rfReveal = networking:FindFirstChild("RF/Fusery/FinishReveal")
    local rfEject = networking:FindFirstChild("RF/Fusery/EjectPet")

    -- 1. ถ้าระบบผสมล็อคอยู่ แปลว่ากำลังผสม 
    if fuseryData.FusionLocked == true then
        -- ถ้ารางวัลออกแล้ว กดรับ
        if type(fuseryData.FusionEggReward) == "table" then
            if rfReveal then rfReveal:InvokeServer() end
        end
        return
    end

    -- 2. ค้นหาสัตว์เลี้ยง 3 ตัวที่เหมือนกันจาก Inventory
    local function FindThreeMatchingPets(inventory)
        local counts = {}
        for uid, petData in pairs(inventory) do
            if petData.InFuse ~= true and petData.IsFavorite ~= true then
                local id = petData.AssetId
                if not counts[id] then counts[id] = {} end
                table.insert(counts[id], uid)
            end
        end
        for id, uids in pairs(counts) do
            if #uids >= 3 then
                return {uids[1], uids[2], uids[3]} -- คืนค่า 3 ตัวแรกที่เจอ
            end
        end
        return nil
    end

    -- สมมติเราดึง Inventory จากเซิร์ฟได้แล้ว
    local inventory = require(game:GetService("ReplicatedStorage").Shared.Save).Get().Inventory
    local petsToLoad = FindThreeMatchingPets(inventory)
    
    if petsToLoad then
        -- โหลดทีละตัวเข้าตู้
        for _, uid in ipairs(petsToLoad) do
            if rfLoad then rfLoad:InvokeServer(uid) end
            task.wait(0.3)
        end
        -- สั่งเริ่มผสม
        if rfBegin then rfBegin:InvokeServer() end
    end
end

