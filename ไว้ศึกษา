==================================================
3.1 ระบบ WalkSpeed / JumpPower Bypass (Humanoid Swap)
==================================================
หลักการ: ตัวเกมมีสคริปต์ Anti-Cheat คอยตรวจจับ Property "WalkSpeed" ของ Humanoid ตัวเดิม
Chilli Hub จึงทำการ "โคลนร่าง (Clone)" Humanoid ตัวใหม่ออกมา แล้วตัด Humanoid ตัวเก่าทิ้ง เพื่อให้สคริปต์ตรวจจับชี้ไปที่ตัวเก่าที่ไม่มีผลอะไรกับตัวละครจริง

```lua
local function ApplyHumanoidSwapBypass()
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then return nil end
    
    local oldHumanoid = character:FindFirstChildOfClass("Humanoid")
    if not oldHumanoid or oldHumanoid.Health <= 0 then return nil end
    
    -- 1. ทำการ Clone Humanoid ออกมา
    local newHumanoid = oldHumanoid:Clone()
    
    -- 2. นำตัวเดิมออกจาก Character
    oldHumanoid.Parent = nil
    
    -- 3. นำตัวใหม่ยัดเข้าไปใน Character
    newHumanoid.Parent = character
    
    -- 4. ตั้งค่ากล้องให้มอง Humanoid ตัวใหม่
    workspace.CurrentCamera.CameraSubject = newHumanoid
    
    -- 5. สลับระบบควบคุมการเดินของผู้เล่น (PlayerModule) มาที่ตัวใหม่
    pcall(function()
        local playerScripts = player:FindFirstChild("PlayerScripts")
        if playerScripts then
            local controlModule = require(playerScripts:WaitForChild("PlayerModule")):GetControls()
            if controlModule then
                controlModule.humanoid = newHumanoid
            end
        end
    end)
    
    -- 6. ปิดระบบคอหักตาย/ข้อต่อหลุดตาย (Godmode Protection)
    newHumanoid.BreakJointsOnDeath = false
    newHumanoid.RequiresNeck = false
    newHumanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    
    -- 7. ปรับความเร็วตามต้องการได้เลย ไม่โดนแบนหรือดีดกลับ
    newHumanoid.WalkSpeed = 120
    
    return newHumanoid
end
```

==================================================
3.2 ระบบค้นหาอาวุธในตัว (Weapon Scanner)
==================================================
หลักการ: ค้นหาว่าตัวละครถือไม้หรือมีอาวุธในกระเป๋าหรือไม่ โดยเช็ค Attribute ของเกม

```lua
local WEAPON_KEYWORDS = {"bat", "katana", "axe", "staff", "club", "hammer", "sword", "blade"}

local function IsValidWeapon(tool)
    if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
        return false
    end
    -- เช็ค Attribute ตรงๆ
    if tool:GetAttribute("IsBat") == true then
        return true
    end
    -- เช็คชื่อ GearName
    local gear = tool:GetAttribute("GearName")
    if type(gear) == "string" then
        gear = string.lower(gear)
        for _, word in ipairs(WEAPON_KEYWORDS) do
            if string.find(gear, word, 1, true) then
                return true
            end
        end
    end
    -- เช็คชื่อ Tool
    local name = string.lower(tool.Name)
    for _, word in ipairs(WEAPON_KEYWORDS) do
        if string.find(name, word, 1, true) then
            return true
        end
    end
    return false
end

local function GetEquippedOrBackpackWeapon()
    local player = game.Players.LocalPlayer
    local char = player.Character
    -- เช็คในมือ
    local inHand = char and char:FindFirstChildWhichIsA("Tool")
    if inHand and IsValidWeapon(inHand) then
        return inHand
    end
    -- เช็คในกระเป๋า
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if IsValidWeapon(item) then
                return item
            end
        end
    end
    return nil
end
```

==================================================
3.3 ระบบดึงภาพไอคอนจากโมเดลเข้า UI (Icon/Texture to rbxassetid://)
==================================================
หลักการ: เวลาสร้าง UI (ImageLabel) ในเกม Roblox จะต้องใส่รูปในฟอร์แมต `rbxassetid://<ID>` เสมอ 
ฟังก์ชันนี้จะสแกนหา Asset ID ไม่ว่าเกมจะซ่อนไว้ใน Attribute หรือ Decal/Texture/MeshPart

```lua
local function ExtractAssetIdForUI(modelOrItem)
    if not modelOrItem then return "" end
    
    local raw = nil
    -- 1. เช็คจากฟิลด์หรือ Attribute โดยตรง
    if type(modelOrItem) == "table" then
        raw = modelOrItem.Icon or modelOrItem.IconId or modelOrItem.AssetId or modelOrItem.Image
    end
    
    local inst = (typeof(modelOrItem) == "Instance") and modelOrItem or (type(modelOrItem) == "table" and modelOrItem.Model)
    if not raw and inst then
        for _, attr in ipairs({"Icon", "IconId", "AssetId", "Image", "Thumbnail", "TextureId"}) do
            local val = inst:GetAttribute(attr)
            if val and tostring(val) ~= "" then
                raw = val
                break
            end
        end
        -- ถ้าใน Attribute ไม่มี ให้มุดค้นหาในชิ้นส่วนย่อย
        if not raw then
            for _, child in ipairs(inst:GetDescendants()) do
                if child:IsA("Decal") or child:IsA("Texture") then
                    raw = child.Texture
                    break
                elseif (child:IsA("ImageLabel") or child:IsA("ImageButton")) and child.Image ~= "" then
                    raw = child.Image
                    break
                elseif child:IsA("MeshPart") and child.TextureID ~= "" then
                    raw = child.TextureID
                    break
                end
            end
        end
    end
    
    -- 2. แปลงเป็นสตริง rbxassetid://
    if type(raw) == "number" or (type(raw) == "string" and raw:match("^%d+$")) then
        return "rbxassetid://" .. tostring(raw)
    end
    if type(raw) == "string" then
        local id = raw:match("rbxassetid://(%d+)") or raw:match("[?&]id=(%d+)")
        if id then
            return "rbxassetid://" .. id
        end
        return raw
    end
    return ""
end
```

