local GraceUntil = 0
local RagdollActive = false

local function ListenForRagdoll_Full()
    local Remotes = require(game:GetService("ReplicatedStorage").Shared.Remotes)
    if Remotes and Remotes.RigSync and Remotes.RigSync.Refresh then
        Remotes.RigSync.Refresh.OnClientEvent:Connect(function(jsonString)
            if typeof(jsonString) ~= "string" then return end
            
            local ok, result = pcall(game:GetService("HttpService").JSONDecode, game:GetService("HttpService"), jsonString)
            if not ok or typeof(result) ~= "table" then return end
            
            local action = result.Action
            local args = typeof(result.Arguments) == "table" and result.Arguments or {}
            
            -- ดักจับว่าตัวละครกำลังจะล้มหรือโดนตี
            if action == "BeginImpulse" or action == "BeginRagdoll" then
                local staggerTime = tonumber(args[1]) or 1
                -- เพิ่มระยะเวลาปลอดภัย (Grace Period) เพื่อหยุดการทำงานของสคริปต์ฟาร์มชั่วคราว
                GraceUntil = math.max(GraceUntil, os.clock() + math.clamp(staggerTime, 1, 5) + 0.5)
                RagdollActive = true
            elseif action == "EndRagdoll" then
                RagdollActive = false
                GraceUntil = math.max(GraceUntil, os.clock() + 1)
            end
        end)
    end
end

