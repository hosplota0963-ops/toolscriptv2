1. ระบบสแกนหาอาวุธ (ไม้ตี) และรีโมทที่ใช้ตี (Weapon Scan & Combat Remote)
==================================================
ใน Chilli Hub จะไม่ได้แค่ดูชื่อ Tool ตรงๆ แต่จะเช็คลงลึกไปถึง Attribute ของ Tool ด้วย
คำที่สคริปต์ใช้ค้นหาอาวุธ: "bat", "katana", "axe", "staff", "club", "hammer", "sword", "blade"

-- โค้ดดึงรีโมทตี
local networking = game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Networking")
local batSwingRemote = networking:FindFirstChild("RE/BatSwing/Trigger")
local toolTriggerRemote = networking:FindFirstChild("RE/ToolTrigger/Trigger")

-- ฟังก์ชันเช็คว่าเป็นอาวุธหรือไม่
local function IsBatTool(tool)
    if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
        return false
    end
    -- วิธีที่ 1: เช็คจาก Attribute โดยตรง (เกมมักจะแปะไว้ให้)
    if tool:GetAttribute("IsBat") == true then
        return true
    end
    -- วิธีที่ 2: เช็คจากชื่อ GearName
    local gearName = tool:GetAttribute("GearName")
    if type(gearName) == "string" then
        gearName = string.lower(gearName)
        local weaponKeywords = {"bat", "katana", "axe", "staff", "club", "hammer", "sword", "blade"}
        for _, keyword in ipairs(weaponKeywords) do
            if string.find(gearName, keyword, 1, true) then
                return true
            end
        end
    end
    return false
end

-- ฟังก์ชันค้นหาอาวุธในตัวและกระเป๋า
local function FindBat(player)
    -- หาในตัวละครที่ถืออยู่ก่อน
    local charTool = player.Character and player.Character:FindFirstChildWhichIsA("Tool")
    if charTool and IsBatTool(charTool) then return charTool end
    
    -- ถ้าไม่ได้ถือ ให้หาในกระเป๋า (Backpack)
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if IsBatTool(tool) then return tool end
        end
    end
    return nil
end

