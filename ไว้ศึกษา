                return true
            end
        end
    end
    -- เช็คชื่อ Tool
    local name = string.lower(tool.Name)
    for _, word in ipairs(WEAPON_KEYWORDS) do
        if string.find(name, word, 1, true) then
            return true
        end
    end
    return false
end

