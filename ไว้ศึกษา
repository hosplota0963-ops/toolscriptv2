หมวดที่ 1: ระบบเชื่อมต่อ Network และ Wrapper พื้นฐาน (Networking Helper)
--------------------------------------------------------------------------------
ในเกม Steal an Egg ตัว Remote ทั้งหมดจะถูกเก็บไว้ที่:
Path: game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Networking")

โค้ด Wrapper สำเร็จรูปสำหรับเรียก Remote Function (Invoke) และ Remote Event (Fire):

```lua
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Networking = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Networking")

local Net = {
    _cache = {}
}

function Net.Get(name)
    if Net._cache[name] ~= nil then
        return Net._cache[name] or nil
    end
    local remote = Networking:FindFirstChild(name)
    Net._cache[name] = remote or false
    return remote
end

-- สำหรับ RemoteFunction
function Net.Invoke(name, ...)
    local rf = Net.Get(name)
    if not rf or not rf:IsA("RemoteFunction") then
        warn("[Net] ไม่พบ RemoteFunction: " .. tostring(name))
        return false, nil
    end
    local ok, res = pcall(rf.InvokeServer, rf, ...)
    return ok, res
end

-- สำหรับ RemoteEvent
function Net.Fire(name, ...)
    local re = Net.Get(name)
    if not re or not re:IsA("RemoteEvent") then
        warn("[Net] ไม่พบ RemoteEvent: " .. tostring(name))
        return false
    end
    return pcall(re.FireServer, re, ...)
end
```

