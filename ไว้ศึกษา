3.4 ระบบบิน/Glide Physics Bypass (ลบล้างแรงเหวี่ยงและปิดการชน)
==================================================
หลักการ: รีเซ็ตแรงเหวี่ยงฟิสิกส์ (`AssemblyLinearVelocity`) ให้เป็นศูนย์ เพื่อป้องกันการตกหรือเด้งกลับ และปิด `CanCollide` ในตัวละครเพื่อให้ทะลุสิ่งกีดขวางได้ 100%

```lua
local TweenService = game:GetService("TweenService")

local function SmoothGlideTo(targetPosition, speed)
    local player = game.Players.LocalPlayer
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- 1. ตัดแรงโน้มถ่วงและแรงหมุน
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    
    -- 2. ปิดการชนของทุกชิ้นส่วนในตัวละคร
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
    
    -- 3. คำนวณเวลาการเดินทางตามความเร็ว (Studs/วินาที)
    local distance = (targetPosition - hrp.Position).Magnitude
    local duration = distance / math.max(10, speed or 350)
    
    -- 4. รัน Tween เคลื่อนที่แบบเส้นตรงอย่างราบรื่น
    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(targetPosition) }
    )
    tween:Play()
    return tween
end
```

