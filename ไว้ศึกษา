    end
    
    -- รูปแบบสุดท้ายที่ต้องคืนค่าคือ "rbxassetid://เลข"
    if type(raw) == "number" or (type(raw) == "string" and raw:match("^%d+$")) then
        return "rbxassetid://" .. tostring(raw)
    end
    if type(raw) == "string" then
        local id = raw:match("rbxassetid://(%d+)") or raw:match("[?&]id=(%d+)")
        if id then
            return "rbxassetid://" .. id
        end
        return raw -- ถ้าแยกไม่ได้ให้ส่งตัวเต็มกลับไป
    end
    return ""
end

